# Frontend (Next.js) — monorepo build for 10BitWorks/shortlinks (QRcodly fork)
# Build context: repo root.
#
# NEXT_PUBLIC_* vars are inlined into the client bundle at build time, so the
# production values below are what ships. The docs generation step
# (`generate:docs`) fetches $NEXT_PUBLIC_API_URL/openapi.json during build; the
# real backend isn't reachable then, so we briefly serve the bundled mcp-server
# spec on localhost and point the env var there for that one command only, then
# restore production before `next build` so the bundle inlines the real URL.
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
# git is needed by the lefthook postinstall during pnpm install
RUN apt-get update && apt-get install -y --no-install-recommends git \
	&& rm -rf /var/lib/apt/lists/*
RUN corepack enable && corepack prepare pnpm@11.13.1 --activate
WORKDIR /app

# ---------- deps (frontend + its workspace deps) ----------
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/frontend/package.json apps/frontend/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
COPY patches patches
RUN pnpm install --frozen-lockfile --filter @apps/frontend...

# ---------- build ----------
FROM base AS build
COPY --from=deps /pnpm /pnpm
COPY --from=deps /app /app
COPY . .
# Server-only secrets are validated at build unless skipped; client NEXT_PUBLIC_* values
# below are the production values that get inlined into the bundle.
ENV SKIP_ENV_VALIDATION=true \
    NEXT_TELEMETRY_DISABLED=1 \
    NODE_ENV=production \
    NEXT_PUBLIC_FRONTEND_URL=https://short.10bit.works \
    NEXT_PUBLIC_SHORT_URL_DOMAIN=https://short.10bit.works \
    NEXT_PUBLIC_API_URL=https://api.10bit.works \
    NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_placeholder_bXVjaC1ob3JuZXQtNDYuY2xlcmsuYWNjb3VudHMuZGV2JA \
    NEXT_PUBLIC_CLERK_JS_URL=/__clerk-js/dist/clerk.browser.min.js \
    NEXT_PUBLIC_SENTRY_DSN=https://placeholder@o0.ingest.sentry.io/0 \
    NEXT_PUBLIC_SENTRY_ENVIRONMENT=production \
    NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_MONTHLY=price_placeholder \
    NEXT_PUBLIC_STRIPE_PRO_PRICE_ID_ANNUAL=price_placeholder \
    NEXT_PUBLIC_STRIPE_ADDON_DOMAIN_PRICE_ID_MONTHLY=price_placeholder \
    NEXT_PUBLIC_STRIPE_ADDON_DOMAIN_PRICE_ID_ANNUAL=price_placeholder \
    NEXT_PUBLIC_GOOGLE_API_KEY=placeholder \
    CLERK_SECRET_KEY=sk_test_placeholder_do_not_use_0123456789abcdef \
    CLERK_ENCRYPTION_KEY=placeholder_clerk_encryption_key_placeholder_ \
    INTERNAL_API_SECRET=placeholder_internal_api_secret_placeholder_00 \
    AXIOM_TOKEN= \
    AXIOM_DATASET=shortlinks
RUN pnpm --filter @shared/schemas --filter @qrcodly/db run build \
	&& node -e "\
const http=require('http'),fs=require('fs');\
const spec=fs.readFileSync('apps/mcp-server/src/openapi.json');\
const s=http.createServer((req,res)=>{res.writeHead(200,{'content-type':'application/json'});res.end(spec);});\
s.listen(8787,'127.0.0.1',()=>console.log('spec server up'));\
" & SPEC_PID=$! \
	&& sleep 1 \
	&& NEXT_PUBLIC_API_URL=http://127.0.0.1:8787 pnpm --filter @apps/frontend run generate:docs \
	&& kill $SPEC_PID 2>/dev/null; \
	pnpm --filter @apps/frontend run build

# ---------- runtime ----------
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    TZ=America/Chicago \
    NEXT_TELEMETRY_DISABLED=1 \
    PORT=3000
COPY --from=build /app/apps/frontend/.next /app/.next
COPY --from=build /app/apps/frontend/node_modules /app/node_modules
COPY --from=build /app/apps/frontend/package.json /app/package.json
COPY --from=build /app/apps/frontend/public /app/public
EXPOSE 3000
CMD ["npx", "next", "start"]
