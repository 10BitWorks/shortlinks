# Backend (Fastify API) — monorepo build for 10BitWorks/shortlinks (QRcodly fork)
# Build context: repo root.
FROM node:22-bookworm-slim AS base
ENV PNPM_HOME=/pnpm
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable && corepack prepare pnpm@11.13.1 --activate
WORKDIR /app

# ---------- deps (backend + its workspace deps) ----------
FROM base AS deps
COPY pnpm-lock.yaml pnpm-workspace.yaml package.json ./
COPY apps/backend/package.json apps/backend/package.json
COPY packages/shared/package.json packages/shared/package.json
COPY packages/db/package.json packages/db/package.json
COPY packages/eslint-config/package.json packages/eslint-config/package.json
COPY packages/typescript-config/package.json packages/typescript-config/package.json
# patches dir is referenced by pnpm-workspace.yaml patchedDependencies
COPY patches patches
RUN pnpm install --frozen-lockfile --filter @apps/backend...

# ---------- build ----------
FROM base AS build
COPY --from=deps /pnpm /pnpm
COPY --from=deps /app /app
COPY . .
# matches root "backend:build": shared packages first, then backend
RUN pnpm --filter @shared/schemas --filter @qrcodly/db run build \
	&& pnpm --filter @apps/backend run build

# ---------- runtime ----------
FROM node:22-bookworm-slim AS runtime
WORKDIR /app
ENV NODE_ENV=production
ENV TZ=America/Chicago
# Compiled output + prod node_modules + package.json (scripts/db config live there)
COPY --from=build /app/apps/backend/build /app/build
COPY --from=build /app/apps/backend/node_modules /app/node_modules
COPY --from=build /app/apps/backend/package.json /app/package.json
# migration files (drizzle) live in src — migrate.ts runs from build, but keep drizzle config assets
COPY --from=build /app/apps/backend/drizzle.config.ts /app/drizzle.config.ts
EXPOSE 5001
# Upstream start = db:migrate && node build/src/index.js. db:migrate uses tsx (dev dep).
# We run migrations at container start via the compiled CLI-equivalent path:
CMD ["sh", "-c", "DB_MIGRATING=true node build/src/core/db/migrate.js && node build/src/index.js"]
